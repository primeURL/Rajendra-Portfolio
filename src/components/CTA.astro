---

---

<div class="w-full flex flex-col items-center bg-transparent">
  <!-- Contact / Reach Out Section -->
  <section id="contact" class="w-full bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Contact Info Column -->
        <div class="flex flex-col gap-8">
          <div>
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">Reach Out</h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg mb-8">Ready to simplify your tax season? We're here to help with all your form filling and filing needs.</p>
          </div>

          <!-- Contact Details Cards -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3">
                <span class="material-symbols-outlined">call</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">Call Us</h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm">+1 (555) 123-4567</p>
              <p class="text-slate-500 dark:text-slate-500 text-xs mt-1">Mon-Fri, 9am - 6pm</p>
            </div>

            <div class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">Email Us</h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm">support@taxformpro.com</p>
              <p class="text-slate-500 dark:text-slate-500 text-xs mt-1">Response within 24h</p>
            </div>

            <div class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800 sm:col-span-2">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3">
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-white mb-1">Visit Office</h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm">123 Financial District Blvd, Suite 400, New York, NY 10005</p>
            </div>
          </div>

          <!-- WhatsApp Action -->
          <div class="mt-4">
            <button class="w-full sm:w-auto flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-3.5 px-8 rounded-lg shadow-md transition-all duration-300">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
              </svg>
              Chat on WhatsApp
            </button>
          </div>
        </div>

        <!-- Contact Form Column -->
        <div class="bg-background-light dark:bg-background-dark p-8 rounded-2xl shadow-lg border border-slate-100 dark:border-slate-800">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Send a Message</h3>
          <form class="space-y-5">
            <div class="grid grid-cols-2 gap-4">
              <div class="col-span-2 sm:col-span-1">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for="name">Full Name</label>
                <input class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none" id="name" placeholder="John Doe" type="text" />
              </div>
              <div class="col-span-2 sm:col-span-1">
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for="phone">Phone Number</label>
                <input class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none" id="phone" placeholder="(555) 000-0000" type="tel" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for="service">Service Needed</label>
              <div class="relative">
                <select class="appearance-none w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none cursor-pointer" id="service">
                  <option disabled selected value="">Select a service...</option>
                  <option value="tax-filing">Income Tax Filing</option>
                  <option value="gst-returns">GST Returns</option>
                  <option value="visa-forms">Visa Application Forms</option>
                  <option value="business-reg">Business Registration</option>
                  <option value="other">Other Consultation</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                  <span class="material-symbols-outlined">expand_more</span>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5" for="message">Message</label>
              <textarea class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none resize-none" id="message" placeholder="Tell us a bit about what you need help with..." rows="4"></textarea>
            </div>

            <button class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3 px-4 rounded-lg shadow-md transition-all duration-200 transform hover:-translate-y-0.5" type="button">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="w-full px-4 sm:px-6 lg:px-8 py-16 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">What Our Clients Say</h2>
      <p class="text-slate-600 dark:text-slate-300">Trusted by hundreds of individuals and businesses across Maharashtra.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-1 mb-4 text-yellow-400">
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
          "Excellent service! They filed my ITR quickly and helped me save money with proper deductions. Highly recommended for anyone who wants hassle-free tax filing."
        </p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">RK</div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Rajesh Kumar</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Business Owner</p>
          </div>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-1 mb-4 text-yellow-400">
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
          "Very professional and knowledgeable team. They handled all my government form submissions and legal documentation with great accuracy and on time."
        </p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">SP</div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Sneha Patil</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Salaried Professional</p>
          </div>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="flex items-center gap-1 mb-4 text-yellow-400">
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
          <span class="material-symbols-outlined text-lg">star</span>
        </div>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">
          "Outstanding GST registration and compliance support. They made the entire process simple and stress-free. I trust them completely with all my filings."
        </p>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">AM</div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">Amit Mehta</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Freelancer</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="w-full bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-auto">
    <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-slate-500 dark:text-slate-400 text-sm">&copy; 2023 TaxPro Solutions. All rights reserved.</p>

      <div class="flex gap-6">
        <!-- Facebook -->
        <a class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-white transition-colors" href="#">
          <span class="sr-only">Facebook</span>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
          </svg>
        </a>
        <!-- Twitter -->
        <a class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-white transition-colors" href="#">
          <span class="sr-only">Twitter</span>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-white transition-colors" href="#">
          <span class="sr-only">LinkedIn</span>
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
          </svg>
        </a>
      </div>

      <div class="flex gap-6 text-sm">
        <a class="text-slate-500 hover:text-primary dark:text-slate-400 transition-colors" href="/policies#privacy">Privacy Policy</a>
        <a class="text-slate-500 hover:text-primary dark:text-slate-400 transition-colors" href="/policies#terms">Terms of Service</a>
      </div>
    </div>
  </footer>
</div>
