<div class="w-full flex flex-col items-center bg-transparent">
  <!-- Contact / Reach Out Section -->
  <section
    id="contact"
    class="w-full bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Contact Info Column -->
        <div class="flex flex-col gap-8">
          <div>
            <h2
              class="text-3xl font-bold text-slate-900 dark:text-white mb-4"
              data-i18n="contact.title"
            >
              Reach Out
            </h2>
            <p
              class="text-slate-600 dark:text-slate-400 text-lg mb-8"
              data-i18n="contact.subtitle"
            >
              Ready to simplify your tax season? We're here to help with all
              your form filling and filing needs.
            </p>
          </div>

          <!-- Contact Details Cards -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div
              class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800"
            >
              <div
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3"
              >
                <span class="material-symbols-outlined">call</span>
              </div>
              <h3
                class="font-bold text-slate-900 dark:text-white mb-1"
                data-i18n="contact.callTitle"
              >
                Call Us
              </h3>
              <a
                href="tel:+918080275912"
                class="text-slate-600 dark:text-slate-400 text-sm hover:text-primary transition-colors"
                data-i18n="contact.callNumber">+91 80802 75912</a
              >
              <p
                class="text-slate-500 dark:text-slate-500 text-xs mt-1"
                data-i18n="contact.callHours"
              >
                Mon-Sat, 9am - 7pm
              </p>
            </div>

            <div
              class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800"
            >
              <div
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3"
              >
                <span class="material-symbols-outlined">mail</span>
              </div>
              <h3
                class="font-bold text-slate-900 dark:text-white mb-1"
                data-i18n="contact.emailTitle"
              >
                Email Us
              </h3>
              <a
                href="mailto:rvlanjewar.online@gmail.com"
                class="text-slate-600 dark:text-slate-400 text-sm hover:text-primary transition-colors break-all"
                data-i18n="contact.emailAddress">rvlanjewar.online@gmail.com</a
              >
              <p
                class="text-slate-500 dark:text-slate-500 text-xs mt-1"
                data-i18n="contact.emailResponse"
              >
                Response within 24h
              </p>
            </div>

            <div
              class="p-4 bg-background-light dark:bg-background-dark rounded-xl border border-slate-100 dark:border-slate-800 sm:col-span-2"
            >
              <div
                class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-3"
              >
                <span class="material-symbols-outlined">location_on</span>
              </div>
              <h3
                class="font-bold text-slate-900 dark:text-white mb-1"
                data-i18n="contact.officeTitle"
              >
                Visit Office
              </h3>
              <p
                class="text-slate-600 dark:text-slate-400 text-sm"
                data-i18n="contact.officeAddress"
              >
                Vasundhara Nagar, Near Old Bus Stand, Nagbhid
              </p>
            </div>
          </div>

          <!-- WhatsApp Action -->
          <div class="mt-4">
            <a
              href="https://wa.me/918080275912?text=Hi%2C%20I%27m%20interested%20in%20your%20services."
