          </div>
        </div>

        <!-- Contact Form Column -->
        <div
          class="bg-background-light dark:bg-background-dark p-8 rounded-2xl shadow-lg border border-slate-100 dark:border-slate-800"
        >
          <h3
            class="text-xl font-bold text-slate-900 dark:text-white mb-6"
            data-i18n="contact.formTitle"
          >
            Send a Message
          </h3>

          <div
            id="form-success"
            class="hidden mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg"
          >
            <p class="text-green-800 dark:text-green-200 text-sm">
              ✓ Message sent successfully! We'll get back to you soon.
            </p>
          </div>

          <div
            id="form-error"
            class="hidden mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg"
          >
            <p class="text-red-800 dark:text-red-200 text-sm">
              ✗ Something went wrong. Please try again.
            </p>
          </div>

          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-2 gap-4">
              <div class="col-span-2 sm:col-span-1">
                <label
                  class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
                  for="name"
                  data-i18n="contact.labelName">Full Name</label
                >
                <input
                  class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none"
                  id="name"
                  name="name"
                  placeholder="Anil Sharma"
                  data-i18n-placeholder="contact.placeholderName"
                  type="text"
                  required
                />
              </div>
              <div class="col-span-2 sm:col-span-1">
                <label
                  class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
                  for="phone"
                  data-i18n="contact.labelPhone">Phone Number</label
                >
                <input
                  class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none"
                  id="phone"
                  name="phone"
                  placeholder="9359851384"
                  data-i18n-placeholder="contact.placeholderPhone"
                  type="tel"
                  required
                />
              </div>
            </div>

            <div>
              <label
                class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
                for="service"
                data-i18n="contact.labelService">Service Needed</label
              >
              <div class="relative">
                <select
                  class="appearance-none w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none cursor-pointer"
                  id="service"
                  name="service"
                  required
                >
                  <option
                    disabled
                    selected
                    value=""
                    data-i18n="contact.placeholderService"
                    >Select a service...</option
                  >
                  <option
                    value="Income Tax Return Filing"
                    data-i18n="contact.optionITR"
                    >Income Tax Return Filing</option
                  >
                  <option
                    value="TDS Return Filing"
                    data-i18n="contact.optionTDS">TDS Return Filing</option
                  >
                  <option
                    value="PAN Card Application"
                    data-i18n="contact.optionPAN">PAN Card Application</option
                  >
                  <option
                    value="UDISE+ Portal Services"
                    data-i18n="contact.optionUDISE"
                    >UDISE+ Portal Services</option
                  >
                  <option
                    value="Saral Portal Services"
                    data-i18n="contact.optionSaral"
                    >Saral Portal Services</option
                  >
                  <option
                    value="MahaIT Scholarship"
                    data-i18n="contact.optionMahaIT">MahaIT Scholarship</option
                  >
                  <option
                    value="Shalarth Online Payment"
                    data-i18n="contact.optionShalarth"
                    >Shalarth Online Payment</option
                  >
                  <option
                    value="Sevarth Online Payment"
                    data-i18n="contact.optionSevarth"
                    >Sevarth Online Payment</option
                  >
                  <option
                    value="MSCEPune Exam Forms"
                    data-i18n="contact.optionMSCEPune"
                    >MSCEPune Exam Forms</option
                  >
                  <option value="GST Registration" data-i18n="contact.optionGST"
                    >GST Registration</option
                  >
                  <option
                    value="Business Registration"
                    data-i18n="contact.optionBiz">Business Registration</option
                  >
                  <option
                    value="Other Consultation"
                    data-i18n="contact.optionOther">Other Consultation</option
                  >
                </select>
                <div
                  class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500"
                >
                  <span class="material-symbols-outlined">expand_more</span>
                </div>
              </div>
            </div>

            <div>
              <label
                class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
                for="message"
                data-i18n="contact.labelMessage">Message</label
              >
              <textarea
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-primary transition-colors outline-none resize-none"
                id="message"
                name="message"
                placeholder="Tell us a bit about what you need help with..."
                data-i18n-placeholder="contact.placeholderMessage"
                rows="4"
                required></textarea>
            </div>

            <button
              id="submit-btn"
              class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3 px-4 rounded-lg shadow-md transition-all duration-200 transform hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed"
              type="submit"
              data-i18n="contact.sendBtn"
            >
              Send Message
            </button>
          </form>
        </div>

        <script>
          const form = document.getElementById(
            "contact-form",
          ) as HTMLFormElement;
          const submitBtn = document.getElementById(
            "submit-btn",
          ) as HTMLButtonElement;
          const successMsg = document.getElementById("form-success");
          const errorMsg = document.getElementById("form-error");

          form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            submitBtn.textContent = "Sending...";
            successMsg?.classList.add("hidden");
            errorMsg?.classList.add("hidden");

            try {
              const formData = new FormData(form);
              const data = {
                name: formData.get("name"),
                phone: formData.get("phone"),
                service: formData.get("service"),
                message: formData.get("message"),
              };

              const response = await fetch("/api/contact", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify(data),
              });

              const result = await response.json();

              if (result.success) {
                successMsg?.classList.remove("hidden");
                form.reset();
              } else {
                errorMsg?.classList.remove("hidden");
              }
            } catch (error) {
              errorMsg?.classList.remove("hidden");
            } finally {
              submitBtn.disabled = false;
              submitBtn.textContent = "Send Message";
            }
          });
          // Visitor counter logic
          async function updateVisitorCount() {
            try {
              const response = await fetch("/api/visitor-count");
              const data = await response.json();
              const counterDigitsEl = document.getElementById(
                "visitor-counter-digits",
              );
              if (counterDigitsEl) {
                // Pad with zeros to 6 digits
                const countString = data.total.toString().padStart(6, "0");

                // Clear and inject new digits
                counterDigitsEl.innerHTML = countString
                  .split("")
                  .map(
                    (digit: string) => `
                    <div class="w-5 h-7 flex items-center justify-center bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-mono font-bold text-sm rounded-sm shadow-sm border border-slate-100 dark:border-slate-700/50">
                      ${digit}
                    </div>
                  `,
                  )
                  .join("");
              }
            } catch (error) {
              console.error("Error fetching visitor count:", error);
            }
          }

          // Fetch count on page load
          updateVisitorCount();
        </script>
      </div>
    </div>
  </section>

