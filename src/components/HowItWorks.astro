---
const services = [
  {
    icon: "receipt_long",
    titleKey: "services.itrTitle",
    title: "Income Tax Return Filing Services Online",
    descKey: "services.itrDesc",
    description: "Complete ITR filing for individuals, salaried employees, freelancers, and businesses. We ensure maximum deductions and full compliance.",
    image: "/images/incometax_portal.png",
    items: [
      { key: "services.itrItem1", text: "Online PAN Card & TAN Card Application Services" },
      { key: "services.itrItem2", text: "Income Tax Return (ITR) Filing Online" },
      { key: "services.itrItem3", text: "Form 10E Filing for Tax Relief" },
      { key: "services.itrItem4", text: "ITR Rectification & Revision Services" },
      { key: "services.itrItem5", text: "Online TDS Return Filing Services" },
      { key: "services.itrItem6", text: "Income Tax Consultation & Advisory" },
    ],
  },
  {
    icon: "edit_document",
    titleKey: "services.saralTitle",
    title: "Saral Portal Services Maharashtra Online",
    descKey: "services.saralDesc",
    description: "Complete assistance with Saral Seva Kendra services including certificates, permits, and all Maharashtra government online applications.",
    image: "/images/saral_portal.png",
    items: [
      { key: "services.saralItem1", text: "Student Portal Registration & Services" },
      { key: "services.saralItem2", text: "Teacher Portal Online Services" },
      { key: "services.saralItem3", text: "School Portal Management Services" },
      { key: "services.saralItem4", text: "School Related Online Work & Documentation" },
    ],
  },
  {
    icon: "gavel",
    titleKey: "services.legalTitle",
    title: "MahaIT Portal Scholarship Services Online",
    descKey: "services.legalDesc",
    description: "Professional assistance with legal paperwork, affidavits, agreements, and registration documents.",
    image: "/images/mahait_portal.png",
    items: [
      { key: "services.legalItem1", text: "Student Scholarship Application & Processing Online" }
    ],
  },
  {
    icon: "storefront",
    titleKey: "services.bizTitle",
    title: "UDISE+ Portal Services & Data Entry",
    descKey: "services.bizDesc",
    description: "End-to-end support for business setup including registration, licensing, and compliance filings.",
    image: "/images/udise_portal.png",
    items: [
      { key: "services.saralItem1", text: "UDISE+ Student Data Entry & Management" },
      { key: "services.saralItem2", text: "UDISE+ Teacher Information System Services" },
      { key: "services.saralItem3", text: "UDISE+ School Portal Data Management" },
      { key: "services.saralItem4", text: "UDISE+ School Related Online Work & Reporting" },
    ],
  },
  {
    icon: "account_balance_wallet",
    titleKey: "services.gstTitle",
    title: "Shalarth & Sevarth Online Payment Services",
    descKey: "services.gstDesc",
    description: "Complete GST compliance including registration, return filing, and reconciliation services.",
    image: "/images/shalarth_portal.png",
    items: [
      { key: "services.gstItem1", text: "Shalarth Online Payment Processing Services" },
      { key: "services.gstItem2", text: "Sevarth Online Payment & Salary Services" }
    ],
  },
  {
    icon: "support_agent",
    titleKey: "services.consultTitle",
    title: "MSCPune Exam Form Filling Services Online",
    descKey: "services.consultDesc",
    description: "One-on-one expert consultation for tax planning, investment advice, and financial decision-making.",
    image: "/images/mscpune_portal.png",
    items: [
      { key: "services.consultItem1", text: "Shishruti Exam Form Filling Online (4th & 7th Standard)" },
      { key: "services.consultItem2", text: "TET Exam Form Filling & Registration Services" },
      { key: "services.consultItem3", text: "NMMS Scholarship Exam Form Filling Online" },
      { key: "services.consultItem4", text: "Government Commercial Certification Exam Registration" },
    ],
  },
];
---

<section id="services" class="py-16">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-i18n="services.title">Comprehensive Tax & Filing Services</h2>
    <p class="text-slate-600 dark:text-slate-300 text-lg" data-i18n="services.subtitle">From income tax returns to business registrations, we provide end-to-end solutions for all your documentation needs.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service) => (
      <div class="group relative rounded-2xl overflow-hidden border border-blue-400 dark:border-blue-500 hover:border-blue-500 dark:hover:border-blue-400 shadow-xl hover:shadow-2xl bg-slate-900/95 dark:bg-slate-900/95 transition-all duration-500">
        <div class="relative backdrop-blur-xl bg-gradient-to-br from-slate-800/90 to-slate-900/90 dark:from-slate-800/90 dark:to-slate-900/90">
          {/* Logo and Title Row */}
          <div class="flex items-center gap-4 p-6 pb-4">
            <div class="size-16 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 shadow-lg shadow-blue-500/40 flex items-center justify-center flex-shrink-0">
              <span class="material-symbols-outlined text-3xl text-white">{service.icon}</span>
            </div>
            <h3 class="text-2xl font-bold text-white" data-i18n={service.titleKey}>{service.title}</h3>
          </div>
          
          {/* Image Section */}
          <div class="px-6 pb-4">
            <div class="relative rounded-xl overflow-hidden shadow-lg">
              <img 
                src={service.image}
                alt={service.title}
                class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          </div>
          
          {/* Description - Commented Out */}
          {/* <p class="px-6 pb-4 text-sm leading-relaxed text-slate-300" data-i18n={service.descKey}>{service.description}</p> */}
          
          {/* Services List */}
          <div class="px-6 pb-6">
            <ul class="space-y-3">
              {service.items.map((item) => (
                <li class="flex items-center gap-3 text-base text-slate-200">
                  <span class="material-symbols-outlined text-xl text-green-400 flex-shrink-0">check_circle</span>
                  <span data-i18n={item.key}>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
