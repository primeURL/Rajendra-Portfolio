---
const services = [
  {
    icon: "receipt_long",
    title: "Income Tax Returns",
    description: "Complete ITR filing for individuals, salaried employees, freelancers, and businesses. We ensure maximum deductions and full compliance.",
    items: ["ITR-1 to ITR-7", "Tax Planning", "Refund Tracking", "Old & New Regime Advisory"],
  },
  {
    icon: "article",
    title: "Government Forms",
    description: "Hassle-free filling and submission of all types of government forms, applications, and documentation.",
    items: ["PAN Card Applications", "Aadhaar Updates", "Passport Forms", "Ration Card"],
  },
  {
    icon: "gavel",
    title: "Legal Documentation",
    description: "Professional assistance with legal paperwork, affidavits, agreements, and registration documents.",
    items: ["Affidavits", "Agreements & Contracts", "Property Documents", "Notary Services"],
  },
  {
    icon: "storefront",
    title: "Business Registration",
    description: "End-to-end support for business setup including registration, licensing, and compliance filings.",
    items: ["GST Registration", "Shop Act License", "MSME Registration", "FSSAI License"],
  },
  {
    icon: "account_balance_wallet",
    title: "GST Services",
    description: "Complete GST compliance including registration, return filing, and reconciliation services.",
    items: ["GST Returns", "GST Registration", "E-Way Bills", "Annual Returns"],
  },
  {
    icon: "support_agent",
    title: "Consultation",
    description: "One-on-one expert consultation for tax planning, investment advice, and financial decision-making.",
    items: ["Tax Saving Tips", "Investment Planning", "Retirement Planning", "NRI Taxation"],
  },
];
---

<section id="services" class="py-16">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 mb-4">
      <span class="material-symbols-outlined text-primary text-sm">miscellaneous_services</span>
      <span class="text-primary dark:text-blue-300 text-xs font-bold uppercase tracking-wider">Our Services</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">Comprehensive Tax & Filing Services</h2>
    <p class="text-slate-600 dark:text-slate-300 text-lg">From income tax returns to business registrations, we provide end-to-end solutions for all your documentation needs.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service) => (
      <div class="group p-6 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-primary/50 hover:shadow-lg transition-all duration-300">
        <div class="size-12 rounded-xl bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-primary group-hover:scale-110 transition-transform mb-5">
          <span class="material-symbols-outlined text-2xl">{service.icon}</span>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{service.title}</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4">{service.description}</p>
        <ul class="space-y-2">
          {service.items.map((item) => (
            <li class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
              <span class="material-symbols-outlined text-green-500 text-base">check_circle</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
