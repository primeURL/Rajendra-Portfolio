---
const services = [
  {
    icon: "receipt_long",
    titleKey: "services.itrTitle",
    title: "Income Tax Returns",
    descKey: "services.itrDesc",
    description: "Complete ITR filing for individuals, salaried employees, freelancers, and businesses. We ensure maximum deductions and full compliance.",
    image: "/images/service-itr.jpg",
    items: [
      { key: "services.itrItem1", text: "ITR-1 to ITR-7" },
      { key: "services.itrItem2", text: "Tax Planning" },
      { key: "services.itrItem3", text: "Refund Tracking" },
      { key: "services.itrItem4", text: "Old & New Regime Advisory" },
    ],
  },
  {
    icon: "edit_document",
    titleKey: "services.saralTitle",
    title: "Saral",
    descKey: "services.saralDesc",
    description: "Complete assistance with Saral Seva Kendra services including certificates, permits, and all Maharashtra government online applications.",
    image: "/images/service-saral.jpg",
    items: [
      { key: "services.saralItem1", text: "Caste & Income Certificates" },
      { key: "services.saralItem2", text: "Domicile Certificate" },
      { key: "services.saralItem3", text: "Age & Nationality Certificate" },
      { key: "services.saralItem4", text: "Other Government Certificates" },
    ],
  },
  {
    icon: "gavel",
    titleKey: "services.legalTitle",
    title: "Legal Documentation",
    descKey: "services.legalDesc",
    description: "Professional assistance with legal paperwork, affidavits, agreements, and registration documents.",
    image: "/images/service-legal.jpg",
    items: [
      { key: "services.legalItem1", text: "Affidavits" },
      { key: "services.legalItem2", text: "Agreements & Contracts" },
      { key: "services.legalItem3", text: "Property Documents" },
      { key: "services.legalItem4", text: "Notary Services" },
    ],
  },
  {
    icon: "storefront",
    titleKey: "services.bizTitle",
    title: "Business Registration",
    descKey: "services.bizDesc",
    description: "End-to-end support for business setup including registration, licensing, and compliance filings.",
    image: "/images/service-business.jpg",
    items: [
      { key: "services.bizItem1", text: "GST Registration" },
      { key: "services.bizItem2", text: "Shop Act License" },
      { key: "services.bizItem3", text: "MSME Registration" },
      { key: "services.bizItem4", text: "FSSAI License" },
    ],
  },
  {
    icon: "account_balance_wallet",
    titleKey: "services.gstTitle",
    title: "GST Services",
    descKey: "services.gstDesc",
    description: "Complete GST compliance including registration, return filing, and reconciliation services.",
    image: "/images/service-gst.jpg",
    items: [
      { key: "services.gstItem1", text: "GST Returns" },
      { key: "services.gstItem2", text: "GST Registration" },
      { key: "services.gstItem3", text: "E-Way Bills" },
      { key: "services.gstItem4", text: "Annual Returns" },
    ],
  },
  {
    icon: "support_agent",
    titleKey: "services.consultTitle",
    title: "Consultation",
    descKey: "services.consultDesc",
    description: "One-on-one expert consultation for tax planning, investment advice, and financial decision-making.",
    image: "/images/service-consultation.jpg",
    items: [
      { key: "services.consultItem1", text: "Tax Saving Tips" },
      { key: "services.consultItem2", text: "Investment Planning" },
      { key: "services.consultItem3", text: "Retirement Planning" },
      { key: "services.consultItem4", text: "NRI Taxation" },
    ],
  },
];
---

<section id="services" class="py-16">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 mb-4">
      <span class="material-symbols-outlined text-primary text-sm">miscellaneous_services</span>
      <span class="text-primary dark:text-blue-300 text-xs font-bold uppercase tracking-wider" data-i18n="services.badge">Our Services</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4" data-i18n="services.title">Comprehensive Tax & Filing Services</h2>
    <p class="text-slate-600 dark:text-slate-300 text-lg" data-i18n="services.subtitle">From income tax returns to business registrations, we provide end-to-end solutions for all your documentation needs.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service) => (
      <div class="group relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-xl transition-all duration-500">
        <!-- Background Image -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 transition-transform duration-500 group-hover:scale-105"
          style={service.image ? `background-image: url('${service.image}'); background-size: cover; background-position: center;` : ''}
        >
          <div class="absolute inset-0 bg-white/85 dark:bg-slate-900/85 backdrop-blur-sm group-hover:bg-white/80 dark:group-hover:bg-slate-900/80 transition-colors duration-500"></div>
        </div>

        <!-- Content -->
        <div class="relative p-6 z-10">
          <div class="size-12 rounded-xl bg-primary/10 dark:bg-primary/20 backdrop-blur-md flex items-center justify-center text-primary group-hover:scale-110 group-hover:bg-primary group-hover:text-white transition-all duration-300 mb-5 shadow-sm">
            <span class="material-symbols-outlined text-2xl">{service.icon}</span>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2" data-i18n={service.titleKey}>{service.title}</h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4" data-i18n={service.descKey}>{service.description}</p>
          <ul class="space-y-2">
            {service.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
                <span class="material-symbols-outlined text-green-500 text-base">check_circle</span>
                <span data-i18n={item.key}>{item.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
