          "@type": "Service",
          name: "Fill Income Tax Online",
          description: "Complete ITR filing online for individuals and businesses"
        }
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "UDISE+ Portal Services",
          description: "UDISE+ online form filling and portal assistance"
