    alternateName: "TaxPro",
    url: siteUrl,
    description:
      "Professional online form filling services for income tax, UDISE+, MahaIT portal, Saral certificates, and all government forms in Maharashtra",
    image: imageURL,
    priceRange: "₹₹",
    areaServed: [
      {
        "@type": "State",
        name: "Maharashtra",
      },
      {
        "@type": "Country",
        name: "India",
      },
    ],
    serviceType: [
      "Income Tax Filing Online",
      "ITR Filing Services",
      "UDISE+ Portal Assistance",
      "MahaIT Portal Services",
      "Saral Portal Certificate Services",
      "Government Form Filing",
      "GST Registration Online",
      "Legal Documentation",
      "Tax Consultation",
      "Caste Certificate Online",
      "Income Certificate Online",
      "Domicile Certificate Online",
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Government Form Filling Services",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Fill Income Tax Online",
