---
const stats = [
  {
    icon: "description",
    labelKey: "stats.formsFilled",
    label: "Forms Filled",
    value: "1,000+",
  },
  {
    icon: "sentiment_satisfied",
    labelKey: "stats.happyClients",
    label: "Happy Clients",
    value: "500+",
  },
  {
    icon: "history",
    labelKey: "stats.yearsExperience",
    label: "Years Experience",
    value: "10+",
  },
];

---

<!-- Stats Section -->
<section id="about" class="py-8">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    {stats.map((stat) => (
      <div class="flex flex-col items-center sm:items-start p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow">
        <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl text-primary mb-4">
          <span class="material-symbols-outlined text-3xl">{stat.icon}</span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 text-sm font-medium uppercase tracking-wide" data-i18n={stat.labelKey}>{stat.label}</p>
        <p class="text-slate-900 dark:text-white text-3xl font-black mt-1">{stat.value}</p>
      </div>
    ))}
  </div>
</section>
