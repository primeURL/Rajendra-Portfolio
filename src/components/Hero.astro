---

<section class="flex flex-col lg:flex-row gap-12 items-center py-10 lg:py-20">
  <!-- Hero Text -->
  <div class="flex-1 flex flex-col gap-6 text-center lg:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 w-fit mx-auto lg:mx-0 border border-blue-100 dark:border-blue-800">
      <span class="material-symbols-outlined text-primary text-sm">verified</span>
      <span class="text-primary dark:text-blue-300 text-xs font-bold uppercase tracking-wider" data-i18n="hero.badge">Certified Professional</span>
    </div>

    <h1 class="text-slate-900 dark:text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight" data-i18n-html="hero.title">
      Professional <span class="text-primary">Online Tax Filing</span> & Government Portal Services
    </h1>

    <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0" data-i18n="hero.subtitle">
      Expert assistance with Income Tax Return filing, TDS returns, UDISE+ data entry, Saral Portal, MahaIT scholarship, Shalarth & Sevarth payments, and MSCPune exam forms. Complete online solutions for all Maharashtra government portals and education services.
    </p>

    <div class="flex flex-col gap-4 pt-4 w-full max-w-2xl mx-auto lg:mx-0">
      <!-- Top Row: Get Help Now & View Services - Side by side on desktop -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="flex items-center justify-center rounded-full h-14 px-8 bg-primary hover:bg-primary-dark text-white text-base font-bold shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 w-full sm:flex-1" data-i18n="hero.cta1">
          Get Help Now
        </a>
        <a href="#services" class="flex items-center justify-center rounded-full h-14 px-8 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-base font-semibold hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors w-full sm:flex-1" data-i18n="hero.cta2">
          View Services
        </a>
      </div>
      
      <!-- WhatsApp Button - Full Width -->
      <a href="https://wa.me/918080275912?text=Hi%2C%20I%20want%20to%20get%20help%20with%20online%20form%20filling%20services.%20I%27m%20interested%20in%20Income%20Tax%20Filing%2C%20UDISE%2B%2C%20MahaIT%20Portal%2C%20or%20Saral%20Certificate%20services." target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 rounded-full h-14 px-8 bg-green-500 hover:bg-green-600 text-white text-base font-bold shadow-lg shadow-green-500/25 transition-all hover:-translate-y-0.5 w-full">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span data-i18n="hero.whatsapp">Chat on WhatsApp</span>
      </a>
    </div>


    <div class="flex items-center gap-2 justify-center lg:justify-start text-sm text-slate-500 dark:text-slate-400 mt-2">
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.noFees">No hidden fees</span>
      <span class="mx-2">&bull;</span>
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.secure">100% Secure</span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="flex-1 w-full max-w-lg lg:max-w-xl relative group">
    <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent rounded-2xl transform rotate-3 scale-105 group-hover:rotate-2 transition-transform duration-500"></div>
    <div
      class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 bg-slate-100 dark:bg-slate-900"
      style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAVPYT7a6GD-qdSeJikf3aLko0cRSedqxUpIGjYkLdHL71GkyvBnJkGrkvUOX5OemBT0A7jPVL8MDGdFG7p0kLTITWSEKKXboQPI0WSU2-c2oeGiSbdjLUo4HSnxcHJ5FErQtWc5x58kxX1jX_fJXHlh_LH7BbepXGMM43JrCqumeKztu3SGhTzdXOELC48kJ66pig3GtZ1s7BMgxxNzIntiVOwK_UqeEZ-nl62tZdX2TId0lK_a6dRHia2gMZl99Mvt43eh59M221H'); background-size: cover; background-position: center;"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6">
        <div class="text-white">
          <p class="font-bold text-lg" data-i18n="hero.imageTitle">Trusted Expertise</p>
          <p class="text-sm opacity-90" data-i18n="hero.imageSubtitle">Helping individuals & businesses since 2013</p>
        </div>
      </div>
    </div>

    <!-- Floating Card -->
    <div class="absolute -bottom-6 -left-6 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-xl border border-slate-100 dark:border-slate-700 hidden sm:flex items-center gap-3 animate-bounce" style="animation-duration: 3s;">
      <div class="bg-green-100 dark:bg-green-900/30 p-2 rounded-full text-green-600 dark:text-green-400">
        <span class="material-symbols-outlined">verified_user</span>
      </div>
      <div>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium" data-i18n="hero.floatingLabel">Verified Filing</p>
        <p class="text-sm font-bold text-slate-900 dark:text-white" data-i18n="hero.floatingValue">Accuracy Guaranteed</p>
      </div>
    </div>
  </div>
</section>
