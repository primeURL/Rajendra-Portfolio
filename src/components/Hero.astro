---

---

<section class="flex flex-col lg:flex-row gap-12 items-center lg:py-2">
  <!-- Hero Text -->
  <div class="flex-1 flex flex-col gap-6 text-center lg:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 w-fit mx-auto lg:mx-0 border border-blue-100 dark:border-blue-800">
      <span class="material-symbols-outlined text-primary text-sm">verified</span>
      <span class="text-primary dark:text-blue-300 text-xs font-bold uppercase tracking-wider" data-i18n="hero.badge">Certified Professional</span>
    </div>

    <h1 class="text-slate-900 dark:text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight" data-i18n-html="hero.title">
      Professional <span class="text-primary">Online Tax Filing</span> & Government Portal Services
    </h1>

    <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0" data-i18n="hero.subtitle">
      Expert assistance with Income Tax Return filing, TDS returns, UDISE+ data entry, Saral Portal, MahaIT scholarship, Shalarth & Sevarth payments, and MSCPune exam forms. Complete online solutions for all Maharashtra government portals and education services.
    </p>

    <div class="flex flex-col gap-4 pt-4 w-full max-w-2xl mx-auto lg:mx-0">
      <!-- Top Row: Get Help Now & View Services - Side by side on desktop -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="flex items-center justify-center rounded-full h-14 px-8 bg-primary hover:bg-primary-dark text-white text-base font-bold shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5 w-full sm:flex-1" data-i18n="hero.cta1">
          Get Help Now
        </a>
        <a href="#services" class="flex items-center justify-center rounded-full h-14 px-8 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-base font-semibold hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors w-full sm:flex-1" data-i18n="hero.cta2">
          View Services
        </a>
      </div>
      
      <!-- WhatsApp Button - Full Width -->
      <a href="https://wa.me/918080275912?text=Hi%2C%20I%20want%20to%20get%20help%20with%20online%20form%20filling%20services.%20I%27m%20interested%20in%20Income%20Tax%20Filing%2C%20UDISE%2B%2C%20MahaIT%20Portal%2C%20or%20Saral%20Certificate%20services." target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 rounded-full h-14 px-8 bg-green-500 hover:bg-green-600 text-white text-base font-bold shadow-lg shadow-green-500/25 transition-all hover:-translate-y-0.5 w-full">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span data-i18n="hero.whatsapp">Chat on WhatsApp</span>
      </a>
    </div>


    <div class="flex items-center gap-2 justify-center lg:justify-start text-sm text-slate-500 dark:text-slate-400 mt-2">
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.noFees">No hidden fees</span>
      <span class="mx-2">&bull;</span>
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.secure">100% Secure</span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="flex-1 w-full max-w-lg lg:max-w-xl relative">
    <!-- Profile Image Card -->
    <div class="relative w-full rounded-2xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 bg-gradient-to-br from-blue-50 to-slate-100 dark:from-slate-800 dark:to-slate-900">
      <!-- Image Container -->
      <div class="relative w-full aspect-[4/3] overflow-hidden">
        <img 
          src="/images/profile_image_rv.jpeg" 
          alt="RV Lanjewar - Tax Filing Expert"
          class="w-full h-full object-cover object-top"
          style="object-position: center 20%;"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
      </div>
      
      <!-- Profile Info Overlay -->
      <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
        <h3 class="text-2xl font-bold mb-1" data-i18n="hero.profileName">RV Lanjewar</h3>
        <p class="text-sm font-medium text-blue-200 mb-2" data-i18n="hero.profileDesignation">Tax Filing & Government Portal Expert</p>
        <div class="flex items-center gap-2 text-sm">
          <span class="material-symbols-outlined text-lg text-green-400">verified</span>
          <span data-i18n="hero.profileExperience">8+ Years Experience</span>
        </div>
      </div>
    </div>

    <!-- About Section Below Image -->
    <div class="mt-2 p-6 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-lg">
      <div class="flex items-start gap-4">
        <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl text-primary flex-shrink-0">
          <span class="material-symbols-outlined text-2xl">person</span>
        </div>
        <div>
          <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2" data-i18n="hero.aboutTitle">About RV Lanjewar</h4>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed" data-i18n="hero.aboutText">
            Certified professional with over 8 years of expertise in income tax filing, government portal services, and online form assistance. Trusted by 1500+ clients across Maharashtra for accurate, timely, and secure documentation services.
          </p>
        </div>
      </div>
    </div>

    <!-- Stylish Floating Verification Badge -->
    <div class="absolute -top-4 -right-4 hidden sm:block animate-pulse" style="animation-duration: 2s;">
      <div class="relative">
        <!-- Glow effect -->
        <div class="absolute inset-0 bg-gradient-to-r from-green-400 to-blue-500 rounded-full blur-lg opacity-75"></div>
        <!-- Badge -->
        <div class="relative bg-white dark:bg-slate-800 p-2 rounded-full shadow-2xl border-2 border-green-500 dark:border-green-400">
          <div class="bg-gradient-to-br from-green-400 to-green-600 p-3 rounded-full">
            <span class="material-symbols-outlined text-2xl text-white" style="font-variation-settings: 'FILL' 1;">verified_user</span>
          </div>
        </div>
        <!-- Badge label -->
        <div class="absolute -bottom-8 left-1/2 transform -translate-x-1/2 whitespace-nowrap">
          <div class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">
            Verified
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
