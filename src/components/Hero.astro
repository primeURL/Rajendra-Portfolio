---

---

<section class="flex flex-col lg:flex-row gap-12 items-center py-10 lg:py-20">
  <!-- Hero Text -->
  <div class="flex-1 flex flex-col gap-6 text-center lg:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 w-fit mx-auto lg:mx-0 border border-blue-100 dark:border-blue-800">
      <span class="material-symbols-outlined text-primary text-sm">verified</span>
      <span class="text-primary dark:text-blue-300 text-xs font-bold uppercase tracking-wider" data-i18n="hero.badge">Certified Professional</span>
    </div>

    <h1 class="text-slate-900 dark:text-white text-4xl sm:text-5xl lg:text-6xl font-black leading-tight tracking-tight" data-i18n-html="hero.title">
      Simplifying Your <span class="text-primary">Tax & Form</span> Filing Needs
    </h1>

    <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed max-w-2xl mx-auto lg:mx-0" data-i18n="hero.subtitle">
      Expert assistance with Income Tax Returns, Government Forms, and Legal Documentation. We handle the paperwork so you can focus on what truly matters to you.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4">
      <button class="flex items-center justify-center rounded-lg h-12 px-8 bg-primary hover:bg-primary-dark text-white text-base font-bold shadow-lg shadow-blue-500/25 transition-all hover:-translate-y-0.5" data-i18n="hero.cta1">
        Get Help Now
      </button>
      <button class="flex items-center justify-center rounded-lg h-12 px-8 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 text-base font-medium hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors" data-i18n="hero.cta2">
        View Services
      </button>
    </div>

    <div class="flex items-center gap-2 justify-center lg:justify-start text-sm text-slate-500 dark:text-slate-400 mt-2">
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.noFees">No hidden fees</span>
      <span class="mx-2">&bull;</span>
      <span class="material-symbols-outlined text-lg text-green-500">check_circle</span>
      <span data-i18n="hero.secure">100% Secure</span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="flex-1 w-full max-w-lg lg:max-w-xl relative group">
    <div class="absolute inset-0 bg-gradient-to-tr from-primary/20 to-transparent rounded-2xl transform rotate-3 scale-105 group-hover:rotate-2 transition-transform duration-500"></div>
    <div
      class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border-4 border-white dark:border-slate-800 bg-slate-100 dark:bg-slate-900"
      style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAVPYT7a6GD-qdSeJikf3aLko0cRSedqxUpIGjYkLdHL71GkyvBnJkGrkvUOX5OemBT0A7jPVL8MDGdFG7p0kLTITWSEKKXboQPI0WSU2-c2oeGiSbdjLUo4HSnxcHJ5FErQtWc5x58kxX1jX_fJXHlh_LH7BbepXGMM43JrCqumeKztu3SGhTzdXOELC48kJ66pig3GtZ1s7BMgxxNzIntiVOwK_UqeEZ-nl62tZdX2TId0lK_a6dRHia2gMZl99Mvt43eh59M221H'); background-size: cover; background-position: center;"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6">
        <div class="text-white">
          <p class="font-bold text-lg" data-i18n="hero.imageTitle">Trusted Expertise</p>
          <p class="text-sm opacity-90" data-i18n="hero.imageSubtitle">Helping individuals & businesses since 2013</p>
        </div>
      </div>
    </div>

    <!-- Floating Card -->
    <div class="absolute -bottom-6 -left-6 bg-white dark:bg-slate-800 p-4 rounded-xl shadow-xl border border-slate-100 dark:border-slate-700 hidden sm:flex items-center gap-3 animate-bounce" style="animation-duration: 3s;">
      <div class="bg-green-100 dark:bg-green-900/30 p-2 rounded-full text-green-600 dark:text-green-400">
        <span class="material-symbols-outlined">verified_user</span>
      </div>
      <div>
        <p class="text-xs text-slate-500 dark:text-slate-400 font-medium" data-i18n="hero.floatingLabel">Verified Filing</p>
        <p class="text-sm font-bold text-slate-900 dark:text-white" data-i18n="hero.floatingValue">Accuracy Guaranteed</p>
      </div>
    </div>
  </div>
</section>
