---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Policies & Terms - Flowvy"
  description="Learn about Flowvy's privacy policy, terms and conditions, cookie policy, data usage, and user rights and responsibilities."
>
  <!-- Skip to content link for accessibility -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg"
  >
    Skip to content
  </a>

  <!-- Main content container -->
  <main id="main-content" class="min-h-screen bg-white dark:bg-[#0B0F1A] transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
      <!-- Page header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">
          Policies & Terms
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Last updated: January 2026
        </p>
      </div>

      <!-- Layout with TOC and content -->
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
        <!-- Table of Contents - Sticky on desktop, collapsible on mobile -->
        <aside class="lg:w-64 flex-shrink-0">
          <!-- Mobile TOC toggle button -->
          <button
            id="toc-toggle"
            class="lg:hidden w-full flex items-center justify-between px-4 py-3 bg-slate-100 dark:bg-white/5 rounded-lg mb-4 text-slate-900 dark:text-white font-medium hover:bg-slate-200 dark:hover:bg-white/10 transition-colors"
          >
            <span>Table of Contents</span>
            <span class="material-icons" id="toc-icon">expand_more</span>
          </button>

          <!-- TOC content -->
          <nav
            id="toc-content"
            class="hidden lg:block lg:sticky lg:top-8 bg-slate-50 dark:bg-white/5 rounded-lg p-6 border border-slate-200 dark:border-white/10"
          >
            <h2 class="text-sm font-semibold text-slate-900 dark:text-white uppercase tracking-wide mb-4">
              On This Page
            </h2>
            <ul class="space-y-3">
              <li>
                <a
                  href="#privacy"
                  class="toc-link block text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  Privacy Policy
                </a>
              </li>
              <li>
                <a
                  href="#terms"
                  class="toc-link block text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  Terms and Conditions
                </a>
              </li>
              <li>
                <a
                  href="#cookies"
                  class="toc-link block text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  Cookie Policy
                </a>
              </li>
              <li>
                <a
                  href="#data-usage"
                  class="toc-link block text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  Data Usage Policy
                </a>
              </li>
              <li>
                <a
                  href="#user-rights"
                  class="toc-link block text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  User Rights and Responsibilities
                </a>
              </li>
            </ul>
          </nav>
        </aside>

        <!-- Main content area -->
        <div class="flex-1 min-w-0">
          <!-- Privacy Policy Section -->
          <section id="privacy" class="mb-16 glass-panel rounded-xl p-8 bg-white/50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="material-icons text-blue-600">shield</span>
              Privacy Policy
            </h2>

            <div class="space-y-6 text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              <p>
                At Flowvy, we take your privacy seriously. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our application. We use Google Firebase Authentication for secure user authentication and data management.
              </p>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Information We Collect
                </h3>
                <p class="mb-3">
                  When you use Flowvy, we collect the following types of information:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Authentication Data:</strong> Through Google Firebase Authentication, we collect your email address, name, and profile photo (if provided through your Google account).</li>
                  <li><strong>Usage Data:</strong> Information about how you use our service, including tasks created, study plans generated, progress tracking data, and notes.</li>
                  <li><strong>Device Information:</strong> Browser type, operating system, IP address, and device identifiers for security and analytics purposes.</li>
                  <li><strong>Cookies and Similar Technologies:</strong> We use cookies to maintain your session and preferences. See our Cookie Policy for more details.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  How We Use Your Information
                </h3>
                <p class="mb-3">
                  We use the collected information for the following purposes:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li>To provide, maintain, and improve our services</li>
                  <li>To personalize your experience and deliver customized study plans</li>
                  <li>To authenticate your identity and maintain account security</li>
                  <li>To track your progress and provide meaningful insights</li>
                  <li>To communicate with you about updates, features, and support</li>
                  <li>To analyze usage patterns and improve our application</li>
                  <li>To detect, prevent, and address technical issues or fraudulent activity</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Storage and Security
                </h3>
                <p class="mb-3">
                  Your data is stored securely using Google Firebase services:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Firebase Firestore:</strong> All user data, including tasks, plans, notes, and progress, is stored in Firebase Firestore with encryption at rest and in transit.</li>
                  <li><strong>Firebase Authentication:</strong> Authentication credentials are managed by Firebase with industry-standard security measures.</li>
                  <li><strong>Security Measures:</strong> We implement appropriate technical and organizational measures to protect your data, including encryption, access controls, and regular security audits.</li>
                  <li><strong>Data Retention:</strong> We retain your data for as long as your account is active or as needed to provide services. You can request deletion at any time.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Third-Party Services
                </h3>
                <p class="mb-3">
                  We use the following third-party services that may collect information:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Google Firebase:</strong> For authentication, database, and hosting services. Firebase's privacy policy applies to data processed by their services.</li>
                  <li><strong>Analytics Services:</strong> We may use analytics tools to understand how users interact with our application (anonymized data only).</li>
                </ul>
                <p class="mt-3">
                  These third-party services have their own privacy policies and we encourage you to review them.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  User Rights
                </h3>
                <p class="mb-3">
                  You have the following rights regarding your personal data:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Right to Access:</strong> You can request a copy of all personal data we hold about you.</li>
                  <li><strong>Right to Deletion:</strong> You can request deletion of your account and all associated data at any time.</li>
                  <li><strong>Right to Portability:</strong> You can export your data in a machine-readable format.</li>
                  <li><strong>Right to Rectification:</strong> You can update or correct your personal information through your account settings.</li>
                  <li><strong>Right to Opt-Out:</strong> You can opt-out of non-essential communications at any time.</li>
                </ul>
                <p class="mt-3">
                  To exercise any of these rights, please contact us.
                </p>
              </div>
            </div>
          </section>

          <!-- Terms and Conditions Section -->
          <section id="terms" class="mb-16 glass-panel rounded-xl p-8 bg-white/50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="material-icons text-blue-600">description</span>
              Terms and Conditions
            </h2>

            <div class="space-y-6 text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              <p>
                These Terms and Conditions ("Terms") govern your use of Flowvy. By accessing or using our service, you agree to be bound by these Terms.
              </p>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Acceptance of Terms
                </h3>
                <p>
                  By creating an account and using Flowvy, you acknowledge that you have read, understood, and agree to be bound by these Terms and our Privacy Policy. If you do not agree to these Terms, you may not use our service.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  User Accounts
                </h3>
                <p class="mb-3">
                  To use Flowvy, you must create an account using Google Firebase Authentication:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li>You must provide accurate and complete information during registration.</li>
                  <li>You are responsible for maintaining the confidentiality of your account credentials.</li>
                  <li>You are responsible for all activities that occur under your account.</li>
                  <li>You must notify us immediately of any unauthorized access or security breach.</li>
                  <li>You must be at least 13 years old to create an account.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  User Obligations
                </h3>
                <p class="mb-3">
                  When using Flowvy, you agree to:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li>Use the service only for lawful purposes and in accordance with these Terms.</li>
                  <li>Not use the service in any way that could damage, disable, or impair our servers or networks.</li>
                  <li>Not attempt to gain unauthorized access to any part of the service, other accounts, or systems.</li>
                  <li>Not use automated systems (bots, scrapers) to access the service without our permission.</li>
                  <li>Not upload or transmit viruses, malware, or any malicious code.</li>
                  <li>Not harass, abuse, or harm other users.</li>
                  <li>Not impersonate any person or entity or misrepresent your affiliation.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Intellectual Property
                </h3>
                <p class="mb-3">
                  All content, features, and functionality of Flowvy are owned by Flowvy Inc. and are protected by copyright, trademark, and other intellectual property laws:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li>You retain ownership of the content you create (tasks, notes, plans).</li>
                  <li>You grant us a license to use, store, and display your content to provide the service.</li>
                  <li>You may not copy, modify, distribute, or reverse engineer any part of our service.</li>
                  <li>Our trademarks, logos, and branding may not be used without our written permission.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Service Availability
                </h3>
                <p>
                  We strive to provide reliable service, but we do not guarantee that Flowvy will be available at all times. We may modify, suspend, or discontinue any part of the service at any time without notice. We are not liable for any interruption or loss of service.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Limitation of Liability
                </h3>
                <p class="mb-3">
                  To the maximum extent permitted by law:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li>Flowvy is provided "as is" without warranties of any kind, express or implied.</li>
                  <li>We are not liable for any indirect, incidental, special, or consequential damages.</li>
                  <li>Our total liability shall not exceed the amount you paid us in the past 12 months.</li>
                  <li>We are not responsible for any loss of data, though we make reasonable efforts to prevent such loss.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Termination
                </h3>
                <p>
                  We reserve the right to suspend or terminate your account at any time for violation of these Terms or for any other reason. You may terminate your account at any time by contacting us. Upon termination, your right to use the service will immediately cease, and we may delete your data after a reasonable grace period.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Governing Law
                </h3>
                <p>
                  These Terms are governed by and construed in accordance with the laws of the United States, without regard to conflict of law principles. Any disputes arising from these Terms or your use of Flowvy shall be resolved in the courts located in the United States.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Changes to Terms
                </h3>
                <p>
                  We may update these Terms from time to time. We will notify you of any material changes by posting the new Terms on this page and updating the "Last updated" date. Your continued use of the service after changes constitutes acceptance of the new Terms.
                </p>
              </div>
            </div>
          </section>

          <!-- Cookie Policy Section -->
          <section id="cookies" class="mb-16 glass-panel rounded-xl p-8 bg-white/50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="material-icons text-blue-600">cookie</span>
              Cookie Policy
            </h2>

            <div class="space-y-6 text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              <p>
                This Cookie Policy explains how Flowvy uses cookies and similar technologies to recognize you when you visit our application. It explains what these technologies are, why we use them, and your rights to control our use of them.
              </p>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  What Are Cookies
                </h3>
                <p>
                  Cookies are small text files that are stored on your device (computer, tablet, or mobile) when you visit a website or use an application. They help the application recognize your device and remember information about your visit, such as your preferences and login status.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Types of Cookies We Use
                </h3>
                <p class="mb-3">
                  We use the following types of cookies:
                </p>
                
                <div class="space-y-4">
                  <div>
                    <h4 class="font-semibold text-slate-900 dark:text-white mb-2">Essential Cookies</h4>
                    <p class="mb-2">These cookies are necessary for the application to function properly:</p>
                    <ul class="list-disc list-inside space-y-1 ml-4">
                      <li><strong>Authentication cookies:</strong> Maintain your login session through Firebase Authentication</li>
                      <li><strong>Security cookies:</strong> Protect against unauthorized access and fraudulent activity</li>
                      <li><strong>Session cookies:</strong> Remember your actions within a single browsing session</li>
                    </ul>
                  </div>

                  <div>
                    <h4 class="font-semibold text-slate-900 dark:text-white mb-2">Preference Cookies</h4>
                    <p class="mb-2">These cookies remember your preferences and settings:</p>
                    <ul class="list-disc list-inside space-y-1 ml-4">
                      <li><strong>Theme preference:</strong> Remember your dark mode or light mode selection</li>
                      <li><strong>Language preference:</strong> Store your preferred language settings</li>
                      <li><strong>UI preferences:</strong> Remember sidebar state and other interface customizations</li>
                    </ul>
                  </div>

                  <div>
                    <h4 class="font-semibold text-slate-900 dark:text-white mb-2">Analytics Cookies</h4>
                    <p class="mb-2">These cookies help us understand how users interact with our application:</p>
                    <ul class="list-disc list-inside space-y-1 ml-4">
                      <li><strong>Usage analytics:</strong> Track which features are used most frequently (anonymized data)</li>
                      <li><strong>Performance monitoring:</strong> Identify and fix technical issues</li>
                      <li><strong>User behavior:</strong> Understand navigation patterns to improve user experience</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Managing Cookies
                </h3>
                <p class="mb-3">
                  You have the right to decide whether to accept or reject cookies:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Browser Settings:</strong> Most web browsers allow you to control cookies through their settings. You can set your browser to refuse cookies or delete certain cookies.</li>
                  <li><strong>Essential Cookies:</strong> Please note that blocking essential cookies may prevent you from using certain features of Flowvy, including authentication.</li>
                  <li><strong>Preference Cookies:</strong> You can disable preference cookies, but this may result in a less personalized experience.</li>
                  <li><strong>Analytics Cookies:</strong> You can opt-out of analytics cookies without affecting your ability to use the application.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Third-Party Cookies
                </h3>
                <p class="mb-3">
                  We use third-party services that may set their own cookies:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Google Firebase:</strong> Sets cookies for authentication and session management. See Google's privacy policy for more information.</li>
                  <li><strong>Analytics Providers:</strong> May set cookies to track usage patterns (if applicable).</li>
                </ul>
                <p class="mt-3">
                  These third-party cookies are subject to the respective privacy policies of these external services.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Updates to This Policy
                </h3>
                <p>
                  We may update this Cookie Policy from time to time to reflect changes in our practices or for legal reasons. We encourage you to review this policy periodically.
                </p>
              </div>
            </div>
          </section>

          <!-- Data Usage Policy Section -->
          <section id="data-usage" class="mb-16 glass-panel rounded-xl p-8 bg-white/50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="material-icons text-blue-600">storage</span>
              Data Usage Policy
            </h2>

            <div class="space-y-6 text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              <p>
                This Data Usage Policy provides detailed information about how Flowvy collects, processes, stores, and shares your data. We are committed to transparency and responsible data handling practices.
              </p>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Collection
                </h3>
                <p class="mb-3">
                  We collect data in the following ways:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Direct Collection:</strong> Information you provide when creating an account, adding tasks, creating study plans, or writing notes.</li>
                  <li><strong>Automatic Collection:</strong> Usage data, device information, and interaction patterns collected automatically as you use the application.</li>
                  <li><strong>Third-Party Collection:</strong> Authentication data collected through Google Firebase when you sign in.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Processing
                </h3>
                <p class="mb-3">
                  We process your data for the following purposes:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Service Delivery:</strong> To provide core functionality including task management, study plan generation, and progress tracking.</li>
                  <li><strong>Personalization:</strong> To customize your experience based on your preferences and usage patterns.</li>
                  <li><strong>Analytics:</strong> To understand how users interact with our application and identify areas for improvement.</li>
                  <li><strong>Security:</strong> To detect and prevent fraud, abuse, and security threats.</li>
                  <li><strong>Communication:</strong> To send you important updates, notifications, and support messages.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Retention
                </h3>
                <p class="mb-3">
                  We retain your data according to the following guidelines:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Active Accounts:</strong> Data is retained for as long as your account remains active.</li>
                  <li><strong>Inactive Accounts:</strong> If your account is inactive for an extended period, we may delete your data after providing notice.</li>
                  <li><strong>Deleted Accounts:</strong> When you delete your account, we remove your personal data within 30 days, except where retention is required by law.</li>
                  <li><strong>Backup Data:</strong> Backup copies may persist for up to 90 days for disaster recovery purposes.</li>
                  <li><strong>Legal Requirements:</strong> We may retain certain data longer if required by law or for legitimate business purposes.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Sharing
                </h3>
                <p class="mb-3">
                  We do not sell your personal data. We may share your data in the following limited circumstances:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Service Providers:</strong> With third-party service providers (like Google Firebase) who help us operate our application, subject to strict confidentiality agreements.</li>
                  <li><strong>Legal Requirements:</strong> When required by law, court order, or government regulation.</li>
                  <li><strong>Business Transfers:</strong> In connection with a merger, acquisition, or sale of assets, with notice to affected users.</li>
                  <li><strong>Protection of Rights:</strong> To protect the rights, property, or safety of Flowvy, our users, or the public.</li>
                  <li><strong>With Your Consent:</strong> When you explicitly consent to sharing your data with third parties.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  Data Security
                </h3>
                <p class="mb-3">
                  We implement multiple layers of security to protect your data:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Encryption:</strong> All data is encrypted in transit (TLS/SSL) and at rest.</li>
                  <li><strong>Access Controls:</strong> Strict access controls limit who can view or modify your data.</li>
                  <li><strong>Authentication:</strong> Secure authentication through Google Firebase with multi-factor authentication support.</li>
                  <li><strong>Monitoring:</strong> Continuous monitoring for suspicious activity and security threats.</li>
                  <li><strong>Regular Audits:</strong> Periodic security audits and vulnerability assessments.</li>
                </ul>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  User Control
                </h3>
                <p class="mb-3">
                  You have control over your data:
                </p>
                <ul class="list-disc list-inside space-y-2 ml-4">
                  <li><strong>Access:</strong> View all data we have about you by requesting a data export.</li>
                  <li><strong>Modify:</strong> Update your profile information and preferences at any time.</li>
                  <li><strong>Delete:</strong> Request deletion of your account and all associated data.</li>
                  <li><strong>Export:</strong> Download your data in a portable format (JSON).</li>
                  <li><strong>Opt-Out:</strong> Control communication preferences and analytics tracking.</li>
                </ul>
                <p class="mt-3">
                  To exercise these rights, contact us.
                </p>
              </div>

              <div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
                  International Data Transfers
                </h3>
                <p>
                  Your data may be transferred to and processed in countries other than your own. We ensure that such transfers comply with applicable data protection laws and that your data receives adequate protection wherever it is processed.
                </p>
              </div>
            </div>
          </section>

          <!-- User Rights and Responsibilities Section -->
          <section id="user-rights" class="mb-16 glass-panel rounded-xl p-8 bg-white/50 dark:bg-white/5 border border-slate-200 dark:border-white/10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-3">
              <span class="material-icons text-blue-600">account_circle</span>
              User Rights and Responsibilities
            </h2>

            <div class="space-y-6 text-base text-slate-700 dark:text-slate-300 leading-relaxed">
              <p>
