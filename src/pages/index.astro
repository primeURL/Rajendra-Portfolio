---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CTA from "../components/CTA.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
---

<Layout
  title="Online Income Tax Return Filing | TDS Return | UDISE+ Data Entry | Saral Portal Services Maharashtra | MahaIT Scholarship Online"
  description="Professional online income tax return filing services, TDS return filing, UDISE+ portal data entry, Saral portal services Maharashtra, MahaIT scholarship application, Shalarth & Sevarth online payment, MSCEPune exam form filling. Expert assistance for ITR filing online, PAN card application, Form 10E, government portal services, and all Maharashtra education portal work. Fast, accurate, and secure online services."
>
  <!-- Sticky Navbar -->
  <div
    class="sticky top-0 z-50 w-full bg-white dark:bg-background-dark border-b border-slate-200 dark:border-slate-800 shadow-sm"
  >
    <header
      class="flex items-center justify-between whitespace-nowrap px-6 py-4 max-w-7xl mx-auto"
    >
      <a
        href="/"
        class="flex items-center gap-3 text-slate-900 dark:text-white"
      >
        <div class="size-8 text-primary">
          <span class="material-symbols-outlined text-3xl">account_balance</span
          >
        </div>
        <h2 class="text-xl font-bold leading-tight tracking-tight">
          TaxPro Solutions
        </h2>
      </a>

      <div class="hidden lg:flex items-center gap-8">
        <nav class="flex items-center gap-6">
          <a
            class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors"
            href="#services"
            data-i18n="nav.services">Services</a
          >
          <a
            class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors"
            href="#about"
            data-i18n="nav.about">About</a
          >
          <a
            class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors"
            href="#testimonials"
            data-i18n="nav.testimonials">Testimonials</a
          >
          <a
            class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors"
            href="#contact"
            data-i18n="nav.contact">Contact</a
          >
        </nav>
        <div class="h-6 w-px bg-slate-200 dark:bg-slate-700"></div>
        <ThemeToggle />
        <div
          class="flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden"
        >
          <button
            data-lang-btn="en"
            class="px-2.5 py-1.5 text-xs font-bold transition-colors rounded-md bg-primary text-white"
            >EN</button
          >
          <button
            data-lang-btn="mr"
            class="px-2.5 py-1.5 text-xs font-bold transition-colors rounded-md text-slate-600 dark:text-slate-300 hover:text-primary hover:bg-slate-100 dark:hover:bg-white/5"
            >MR</button
          >
          <button
            data-lang-btn="hi"
            class="px-2.5 py-1.5 text-xs font-bold transition-colors rounded-md text-slate-600 dark:text-slate-300 hover:text-primary hover:bg-slate-100 dark:hover:bg-white/5"
            >HI</button
          >
        </div>
        <a
          href="https://wa.me/918080275912?text=Hi%2C%20I%20want%20to%20get%20help%20with%20online%20form%20filling%20services.%20I%27m%20interested%20in%20Income%20Tax%20Filing%2C%20UDISE%2B%2C%20MahaIT%20Portal%2C%20Saral%20Certificates%2C%20GST%20Registration%2C%20or%20Legal%20Documentation%20services.%20Please%20assist%20me."
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center rounded-lg h-10 w-10 bg-green-500 hover:bg-green-600 text-white transition-colors shadow-md shadow-green-500/20"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-3 lg:hidden">
        <ThemeToggle />
        <button
          id="mobile-menu-btn"
          class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/5 rounded-lg transition-colors"
        >
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </header>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-background-dark"
    >
      <nav class="flex flex-col px-6 py-4 space-y-3">
        <a
          class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors py-2"
          href="#services"
          data-i18n="nav.services">Services</a
        >
        <a
          class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors py-2"
          href="#about"
          data-i18n="nav.about">About</a
        >
        <a
          class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors py-2"
          href="#testimonials"
          data-i18n="nav.testimonials">Testimonials</a
        >
        <a
          class="text-slate-600 dark:text-slate-300 text-sm font-medium hover:text-primary transition-colors py-2"
          href="#contact"
          data-i18n="nav.contact">Contact</a
        >
        <div class="pt-2 border-t border-slate-200 dark:border-slate-700">
          <div
            class="flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden w-fit"
          >
            <button
              data-lang-btn="en"
              class="px-3 py-1.5 text-xs font-bold transition-colors rounded-md bg-primary text-white"
              >EN</button
            >
            <button
              data-lang-btn="mr"
              class="px-3 py-1.5 text-xs font-bold transition-colors rounded-md text-slate-600 dark:text-slate-300 hover:text-primary hover:bg-slate-100 dark:hover:bg-white/5"
              >MR</button
            >
            <button
              data-lang-btn="hi"
              class="px-3 py-1.5 text-xs font-bold transition-colors rounded-md text-slate-600 dark:text-slate-300 hover:text-primary hover:bg-slate-100 dark:hover:bg-white/5"
              >HI</button
            >
          </div>
        </div>
        <button
          class="flex items-center justify-center rounded-lg h-10 px-5 bg-primary hover:bg-primary-dark text-white text-sm font-bold transition-colors shadow-md shadow-primary/20 mt-2"
        >
          <span data-i18n="nav.getStarted">Get Started</span>
        </button>
      </nav>
    </div>
  </div>

  <!-- Main Content -->
  <main class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Hero />
    <HowItWorks />
    <Features />
  </main>

  <CTA />

  <LanguageSwitcher />

  <script>
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    mobileMenuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
    });

    const mobileMenuLinks = mobileMenu?.querySelectorAll("a");
    mobileMenuLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("hidden");
      });
    });

    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e: Event) {
        e.preventDefault();
        const href = (e.currentTarget as HTMLAnchorElement).getAttribute(
          "href",
        );
        const target = document.querySelector(href || "");
        if (target) {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });
  </script>
</Layout>

